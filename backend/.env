# CodeCache Pro Backend Configuration
# -----------------------------------

# Server port
PORT=5050

# Maximum cache size in bytes (Default: 5 GB)
CACHE_SIZE_LIMIT_BYTES=5368709120

# Base URL for the upstream npm registry
NPM_REGISTRY_URL=https://registry.npmjs.org

# Base URL for the upstream PyPI registry
PYPI_REGISTRY_URL=https://pypi.org/simple

# Log level (error, warn, info, http, verbose, debug, silly)
LOG_LEVEL=info